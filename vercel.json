{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/bridge.js": {
      "maxDuration": 180
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/bridge?__path=:path*"
    }
  ]
}
